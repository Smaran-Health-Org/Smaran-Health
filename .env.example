# Host port exposed by Docker Compose. No secrets are required by the current
# marketing and clickable-prototype application.
APP_PORT=3000

# Future clinical services must keep secrets in an untracked .env file. Do not
# add real patient data or production credentials to this template.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
