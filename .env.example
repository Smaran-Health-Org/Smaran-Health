# Copy to .env and paste the same key the clinical app uses.
# Never commit .env — the repo-root .gitignore already ignores **/.env
SARVAM_API_KEY=

# Optional
PROBE_PORT=8787
PROBE_MODEL=saaras:v3

# Shared clip library (dedicated probe/test Supabase project — never the clinical one).
# The publishable key is intentionally public; RLS policies only cover the probe
# bucket/tables created by tools/sarvam-probe/supabase/migrations/20261019000000_probe_clip_library.sql.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=probe-fixtures
