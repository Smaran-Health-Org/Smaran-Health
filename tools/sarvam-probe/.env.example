# Copy to .env and paste the same key the clinical app uses.
# Never commit .env — the repo-root .gitignore already ignores **/.env
SARVAM_API_KEY=

# Optional
PROBE_PORT=8787
PROBE_MODEL=saaras:v3

# Clip library backend: "local" (fixtures/ on disk) or "supabase" (shared bucket).
# Use a DEDICATED probe/test project — never the clinical project.
PROBE_FIXTURE_BACKEND=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=probe-fixtures

# Keep the probe server on localhost. Only bind wider (e.g. 0.0.0.0) if you
# understand the probe then trusts your LAN — and remember mobile needs HTTPS
# for microphone access, so a tunnel is usually the better option.
PROBE_HOST=127.0.0.1
