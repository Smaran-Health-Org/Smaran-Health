!apps/clinical/src/app/recordings/
!apps/clinical/src/app/recordings/**
!apps/clinical/src/app/api/recordings/
!apps/clinical/src/app/api/recordings/**
**/uploads/
**/exports/
**/.backups/
**/backups/
**/*.wav
**/*.mp3
**/*.m4a
**/*.webm
**/*.dump
**/*.backup
**/*.sqlite
**/*.sqlite3

