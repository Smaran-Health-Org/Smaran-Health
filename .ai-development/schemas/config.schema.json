{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ai-development-config/v1"
    },
    "repository": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_root": {
      "const": ".ai-development"
    },
    "work_item_root": {
      "const": ".ai-development/work-items"
    },
    "target_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "supported_states": {
      "type": "array",
      "const": [
        "refinement_pending",
        "refinement_approved",
        "planning",
        "plan_ready",
        "plan_approved"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_yaml_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "max_yaml_bytes",
        "max_artifact_bytes",
        "max_depth"
      ]
    }
  },
  "required": [
    "schema_version",
    "repository",
    "artifact_root",
    "work_item_root",
    "target_branch",
    "supported_states",
    "policy"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smaran deterministic pipeline configuration v1"
}
