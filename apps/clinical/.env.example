# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMARAN_LOCAL_SEED=1

# Database (admin connection for Drizzle/seed — bypasses RLS intentionally)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
APP_URL=http://localhost:3000

# Session policy (security). Sessions are time-boxed and idle-limited:
#   SESSION_MAX_AGE_HOURS               — force re-authentication after N hours
#                                         (absolute cap; server-enforced).
#   NEXT_PUBLIC_SESSION_INACTIVITY_MINUTES — auto sign-out after N minutes of
#                                         inactivity (client-enforced).
SESSION_MAX_AGE_HOURS=12
NEXT_PUBLIC_SESSION_INACTIVITY_MINUTES=30

# AI — provider selection. One small change switches the extraction provider:
#   auto      (default) Grok is primary when GROK_API_KEY is set, else DeepSeek;
#             falls back to the other provider if the primary is unavailable.
#   deepseek  force DeepSeek (Grok is the fallback)
#   grok      force Grok (DeepSeek is the fallback)
AI_PROVIDER=auto

# AI — DeepSeek (OpenAI-compatible) for structured extraction + draft generation
DEEPSEEK_API_KEY=

# AI — Grok / xAI (OpenAI-compatible). PLACEHOLDER for now: leave empty to run
# on DeepSeek only. When set, Grok becomes the primary provider under
# AI_PROVIDER=auto and DeepSeek is used automatically if Grok fails.
GROK_API_KEY=

# AI — Sarvam speech-to-text (server-side transcription of recorded audio).
# saaras:v3, codemix mode keeps Hinglish faithful. Get a key at
# console.sarvam.ai; never expose it to the browser — only the server-side
# audio-recording transcription adapter reads it.
SARVAM_API_KEY=

# DEMO ONLY — live transcript preview in the recording panel.
# When 1, an authenticated doctor can fetch the Sarvam key and open Sarvam's
# realtime WebSocket directly from the browser. The key is visible in devtools.
# Use only for the private hackathon demo, then set back to 0 and rotate the key.
# Production must use a server-side relay instead.
LIVE_TRANSCRIPT_DEMO=0
LIVE_TRANSCRIPT_MODEL=saaras:v3-realtime
LIVE_TRANSCRIPT_LANGUAGE=auto

# Sarvam diagnostics. Every Sarvam request is logged as structured JSON to
# stdout (visible in the Vercel function log) and appended to one JSONL file
# dedicated to Sarvam, so an incident can be reconstructed without wading
# through unrelated logs. Inspect it with: npm run sarvam:log
#   SARVAM_LOG_FILE     — override the sink path. Defaults to <repo>/.logs/
#                         sarvam.jsonl locally and /tmp/smaran-sarvam.jsonl on
#                         Vercel (its filesystem is read-only elsewhere).
#   SARVAM_LOG_DISABLED — set to 1 to silence the log entirely.
# The log never contains transcripts, audio bytes, patient details or API keys;
# presigned storage URLs are reduced to their host.
SARVAM_LOG_FILE=
SARVAM_LOG_DISABLED=

# Secure patient intake (use a random value of at least 32 characters)
INTAKE_CREDENTIAL_PEPPER=
# Local development defaults to preview. Webhook delivery uses
# INTAKE_DELIVERY_WEBHOOK_URL/_TOKEN; live email invitations go through Resend.
INTAKE_DELIVERY_MODE=preview
INTAKE_DELIVERY_WEBHOOK_URL=
INTAKE_DELIVERY_WEBHOOK_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Smaran Health

# AI — OpenAI (gpt-4o vision) for medical-document transcription + classification.
# Required for document processing. Not used for the clinical-note draft path
# (that stays on DeepSeek/Grok via AI_PROVIDER).
OPENAI_API_KEY=
# Versioned medical-document processing adapter (server-only). Only "openai"
# is supported. PDF (text + page images) and JPEG/PNG/WEBP are handled natively
# via the Responses API; HEIC/HEIF are rejected as unsupported by OpenAI.
DOCUMENT_PROCESSING_PROVIDER=openai
DOCUMENT_PROCESSING_MODEL=gpt-4o
# Optional but recommended: random 32+ character secret for HMAC-only likely-duplicate matching.
DOCUMENT_IDENTITY_HMAC_SECRET=
# Required in deployed environments for the protected durable-work scheduler.
CRON_SECRET=
