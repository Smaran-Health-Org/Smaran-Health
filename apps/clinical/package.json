{
  "name": "clinical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/tests/*.test.ts",
    "test:db": "supabase test db --local supabase/tests",
    "test:db:phase8-lock-order": "tsx --test scripts/test-phase8-lock-order.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx supabase migration up --local",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:reset": "npx supabase db reset --local",
    "bootstrap": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
